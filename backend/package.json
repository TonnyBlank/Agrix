{
  "name": "agrilink-backend",
  "version": "1.0.0",
  "description": "AgriLink X Django backend",
  "main": "main.py",
  "scripts": {
    "dev": ".venv/bin/python manage.py runserver 127.0.0.1:3001",
    "start": ".venv/bin/python -m uvicorn config.asgi:application --host 127.0.0.1 --port 3001",
    "start:public": ".venv/bin/python -m uvicorn config.asgi:application --host 0.0.0.0 --port 3001",
    "check": ".venv/bin/python manage.py check"
  }
}
